# Create a preauthorized, reusable auth key in the Tailscale admin console.
TS_AUTHKEY=

# Rootless Podman socket directory. Change 1000 if `id -u` reports another UID.
XDG_RUNTIME_DIR=/run/user/1000

# Comma-separated Tailscale login names that may mutate services and open Exec.
ADMIN_USERS=you@example.com

# Host Bash is disabled until the one-time host-agent install is complete.
# Every login below must also appear exactly in ADMIN_USERS.
HOST_SHELL_ENABLED=false
HOST_SHELL_USERS=

TS_HOSTNAME=homelab-dashboard

# Optional probe allowlist override. The default includes RFC1918, CGNAT and ULA.
PROBE_ALLOW_CIDRS=

# Metric history uses tiered 10s/1m/15m and 30s/5m/1h retention up to 90 days.
# Default: 2 GiB. Raw samples pause at 100%; live metrics keep running.
HISTORY_QUOTA_BYTES=2147483648

# Optional ntfy alerts. Set URL + topic together. For a protected topic, set
# NTFY_TOKEN_FILE to a 0600 file on the HOST; leave it empty for anonymous ntfy.
# Leave URL + topic empty to disable notification delivery entirely.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN_FILE=
