# Create a preauthorized, reusable auth key in the Tailscale admin console.
TS_AUTHKEY=

# Rootless Podman socket directory. Change 1000 if `id -u` reports another UID.
XDG_RUNTIME_DIR=/run/user/1000

# Use an immutable GitHub Container Registry or Docker Hub release tag. Never
# use `latest` on a production homelab; select the version from GitHub Releases.
# Replace <release-tag> with a container-enabled release listed on GitHub.
# DASHBOARD_IMAGE=ghcr.io/bnhminh1010/homelab-dashboard:<release-tag>
# DASHBOARD_IMAGE=docker.io/minhtuyetvoi/homelab-dashboard:<release-tag>
DASHBOARD_IMAGE=

# Comma-separated Tailscale login names that may mutate services and open Exec.
ADMIN_USERS=you@example.com

# Host Bash is disabled until the one-time host-agent install is complete.
# Every login below must also appear exactly in ADMIN_USERS.
HOST_SHELL_ENABLED=false
HOST_SHELL_USERS=

TS_HOSTNAME=homelab-dashboard

# Optional probe allowlist override. The default includes RFC1918, CGNAT and ULA.
PROBE_ALLOW_CIDRS=

# Metric history uses tiered 10s/1m/15m and 30s/5m/1h retention up to 90 days.
# Default: 2 GiB. Raw samples pause at 100%; live metrics keep running.
HISTORY_QUOTA_BYTES=2147483648

# Optional ntfy alerts. Set URL + topic together. For a protected topic, set
# NTFY_TOKEN_FILE to a 0600 file on the HOST; leave it empty for anonymous ntfy.
# Leave URL + topic empty to disable notification delivery entirely.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN_FILE=

# Optional generic webhook delivery. Set URL + secret file together. The
# request body is JSON and signed as `sha256=<hex>` in X-Homelab-Signature.
# Keep the secret in a 0600 HOST file; it is never placed in the environment
# inside the dashboard container.
WEBHOOK_URL=
WEBHOOK_SECRET_FILE=

# Optional local-host backup report. A backup job writes the JSON contract
# documented in deploy/node-agent/README.md atomically to this HOST path.
# Leave empty when no local backup report is available.
BACKUP_STATUS_FILE=
